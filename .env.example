FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Fine-grained PAT limited to first24/AIHelper:
# Actions read/write, Contents read, Pull requests read/write.
GH_TOKEN=
# Reuse your existing Git Credential Manager login if GH_TOKEN is empty.
USE_GIT_LOGIN=true
GITHUB_REPOSITORY=first24/AIHelper
GITHUB_REF_NAME=main
# Optional HTTPS proxy for GitHub API only. Otherwise reuse Git's http.proxy if set.
GITHUB_PROXY=
# Get your own open_id with: python -m assistant discover, then DM /whoami.
ALLOWED_OPEN_IDS=
ASSISTANT_DB=data/jobs.sqlite3
