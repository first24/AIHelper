FEISHU_APP_ID=
FEISHU_APP_SECRET=
# general = natural language, reminders, todos, mail and optional GitHub.
# legacy = original code-repair-only service.
ASSISTANT_MODE=general
ASSISTANT_TIMEZONE=Asia/Shanghai
# This key is for the assistant service, separate from the GitHub Secret.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Fine-grained PAT limited to first24/AIHelper:
# Actions read/write, Contents read/write, Pull requests read/write.
GH_TOKEN=
# Reuse your existing Git Credential Manager login if GH_TOKEN is empty.
USE_GIT_LOGIN=false
GITHUB_REPOSITORY=first24/AIHelper
GITHUB_REF_NAME=main
# Optional HTTPS proxy for GitHub API only. Otherwise reuse Git's http.proxy if set.
GITHUB_PROXY=
# Get your own open_id with: python -m assistant discover, then DM /whoami.
ALLOWED_OPEN_IDS=
ASSISTANT_DB=data/jobs.sqlite3

# QQ Mail: enable SMTP and generate a client authorization code in QQ Mail.
# Use the full mailbox address, and the authorization code (not the QQ password).
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_AUTH_CODE=

# Personal Weixin ClawBot. Bind on the server with: python -m assistant weixin-login
WEIXIN_ENABLED=false
# Optional for a single allowed Feishu user. Select the same owner to share tasks.
WEIXIN_OWNER_OPEN_ID=

# Connected assistant (no extra key required for default Bing RSS search).
TAVILY_API_KEY=
IMAP_HOST=imap.qq.com
# Optional when ALLOWED_OPEN_IDS contains exactly one owner.
MAILBOX_OWNER_OPEN_ID=
# Personal calendar permissions: read, write (create/update), delete (also cancel).
# Match the user's explicit consent and published Feishu scopes.
CALENDAR_ACCESS=read
# Workflow code and the actual project target can use different branches.
PROJECT_WORKFLOW_REF=feature/connected-assistant
PROJECT_BASE_REF=feature/connected-assistant
# Optional JSON registry. Each test_command is an argv list, never shell text.
# PROJECT_REPOSITORIES_JSON={"first24/AIHelper":{"ref":"main","test_command":["python","-m","unittest","discover","-s","tests","-v"]}}
